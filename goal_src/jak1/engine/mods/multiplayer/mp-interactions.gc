(defun handle-remote-interaction ((remote-player remote-player-info) (tgt-idx int))
  (when (!= (-> remote-player inter_type) (interaction-type none))
    (case (-> remote-player inter_type)
      (((interaction-type eco-yellow) (interaction-type eco-red) (interaction-type eco-blue) (interaction-type eco-green))
        (when (is-level-alive-or-active? (-> remote-player inter_level))
          (when (is-level-alive-or-active? (-> remote-player inter_level))
            )
          (if (string-starts-with= (-> remote-player inter_parent) "crate-")
            (pickup-crate-eco (-> remote-player inter_parent))
            )

          (if (and (not (string-starts-with= (-> remote-player inter_name) "ecovent-")) (not (string-starts-with= (-> remote-player inter_name) "vent")) (not (string= (-> remote-player inter_name) "reflector-mirror-2")))
            (pickup-eco (-> remote-player inter_name))
            )
          )

        (if (and (= (-> remote-player inter_type) (interaction-type eco-green)) (= (-> remote-player inter_amount) 1) (string-starts-with= (-> remote-player inter_name) "ecovent-"))
          (give-eco-to-target-idx tgt-idx (the int (-> remote-player inter_type)) 5.0)
          (give-eco-to-target-idx tgt-idx (the int (-> remote-player inter_type)) (-> remote-player inter_amount))
          )
        )
      (((interaction-type money))
        (cond 
          ;; set orb count
          ((string= (-> remote-player inter_parent) "client")
            (let ((adjust-amount (- (-> remote-player inter_amount) (-> *game-info* money))))
              (when (!= adjust-amount 0)
                (send-event *target* 'get-pickup 5 adjust-amount)
                )
              (if (not (string= (-> remote-player inter_level) "none"))
                (set-level-money (-> remote-player inter_level) (the int (-> remote-player inter_status)) adjust-amount)
                )
              )
            )
          ;; remove orb
          (else
            (cond 
              ((string-starts-with= (-> remote-player inter_parent) "orb-cache-top-")
                (kill-cache-orb (-> remote-player inter_parent))
                )
              ((string-starts-with= (-> remote-player inter_parent) "crate-")
                (kill-crate-orb (-> remote-player inter_parent))
                )
              ((string-starts-with= (-> remote-player inter_parent) "gnawer-")
                (kill-gnawer-orb (-> remote-player inter_parent))
                )
              ((string-starts-with= (-> remote-player inter_parent) "plant-boss-")
                (kill-plant-boss-orb)
                )
              (else
                (kill-orb (-> remote-player inter_name))
                )
              )
            )
          )
        )
      (((interaction-type game-task))
        (when (!= (the-as game-task (the int (-> remote-player inter_amount))) (game-task finalboss-movies))
          (if (is-task-cell-collect? (the-as game-task (the int (-> remote-player inter_amount))) (the-as task-status (the int (-> remote-player inter_status))))
            (dm-give-cell-from-remote (the-as game-task (the int (-> remote-player inter_amount))))
            (close-specific-task-from-remote! (the-as game-task (the int (-> remote-player inter_amount))) (the-as task-status  (the int (-> remote-player inter_status))))
            )
          )
        )
      (((interaction-type enemy-death))
        (kill-enemy (-> remote-player inter_name))
        )
      (((interaction-type buzzer))
        (if (= (-> remote-player inter_cleanup) 0)
          (give-buzzer-from-level (-> remote-player inter_amount) (-> remote-player inter_level))
          )
        
        (if (and (is-level-alive-or-active? (-> remote-player inter_level)) (string-starts-with= (-> remote-player inter_parent) "crate-"))
          (kill-crate-buzzer (-> remote-player inter_parent) (or (= (-> remote-player inter_cleanup) 0) (name= (-> remote-player inter_name) "buzzer-last")) (= (-> remote-player inter_cleanup) 1))
          )
        )
      (((interaction-type crate))
        (break-crate (-> remote-player inter_name))
        )
      (((interaction-type fish))
        (set-fish-stats (-> remote-player inter_amount) (-> remote-player inter_status))
        )
      (((interaction-type periscope))
        (periscope-activate-by-name (-> remote-player inter_name))
        )
      (((interaction-type snow-bumper))
        (deactivate-snow-bumper (-> remote-player inter_name))
        )
      (((interaction-type dark-crystal))
        (explode-dark-crystal (-> remote-player inter_name)  (the int (-> remote-player inter_status)))
        )
      (((interaction-type lpc-chamber))
        (move-lpc-chamber (the int (-> remote-player inter_status)))
        )
      (((interaction-type boss-phase))
        (move-boss-to-phase (-> remote-player inter_name) (the int (-> remote-player inter_amount)) (= (-> remote-player inter_status) 1))
        )
      (((interaction-type taunt))
        (handle-remote-taunt tgt-idx (-> remote-player inter_name))
        )
      )
    )
    (none)
  )